# Copy to .env for local use. NEVER commit a real .env file.
# Production: set MONGO_URI to a MongoDB Atlas connection string in Vercel.
MONGO_URI=
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d
PORT=5001
CLIENT_URL=http://localhost:5173
# Local testing only: leave MONGO_URI empty to use an in-memory MongoDB.
# In-memory data is temporary and is lost when the server stops.
